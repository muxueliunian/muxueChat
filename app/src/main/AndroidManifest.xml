<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        usesCleartextTraffic：经用户确认开启，用于接入没有证书的局域网自建服务。
        风险：明文 http 端点下，Authorization 头（API Key）与聊天正文都不加密，
        同网段或链路上的设备可以读取。请只把 http 地址用于自己可控的局域网。
        应用层对 http 地址不再做范围限制，安全性完全取决于用户填写的地址。
    -->
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="muxueChat"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.MuxueChat">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
